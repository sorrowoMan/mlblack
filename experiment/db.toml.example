[experiment_db]
enabled = true
mode = "prefer"
readonly = false

# Option 1: explicit target URL
# url = "postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/mlblack_catalog"

# Option 2: structured target fields
backend = "postgresql"
host = "127.0.0.1"
port = 5432
user = "postgres"
password = ""
database = "mlblack_catalog"
driver = "postgresql+psycopg"

# SQLite fallback example:
# backend = "sqlite"
# path = "./runs/experiments.sqlite3"

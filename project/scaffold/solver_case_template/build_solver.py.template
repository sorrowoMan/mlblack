"""可运行的 ML 线性回归 Case；修改 pipeline 数据入口即可接入自己的数据。"""
from mlblack.project.starter import build_starter_trainer
from .pipeline import build_pipeline


def build_solver(config=None, *, resource_context=None, component_overrides=None):
    data = build_pipeline(resource_context=resource_context,
                          component_overrides=component_overrides)
    return build_starter_trainer(data, resource_context=resource_context,
                                 component_overrides=component_overrides)

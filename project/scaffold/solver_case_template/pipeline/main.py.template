"""ML 数据管线入口；返回 NumericDataView，支持显式 transform slot。"""
from blackbase.kernel import PipelineSpec, build_pipeline_kernel
from mlblack.project.starter import build_starter_data


def build_pipeline(*, resource_context=None, component_overrides=None):
    overrides = dict(component_overrides or {})
    data = build_starter_data()
    if "pipeline_spec" not in overrides:
        return data
    return run_pipeline_slot("transform", data, component_overrides=overrides,
                             context={"resource_context": resource_context})


def run_pipeline_slot(slot, value, *, component_overrides=None, context=None):
    overrides = dict(component_overrides or {})
    spec = PipelineSpec.from_value(overrides.get("pipeline_spec", {"key": "default", "slots": ()}))
    kernel = build_pipeline_kernel(spec, operator_registry=dict(overrides.get("pipeline_operators", {}) or {}))
    return kernel.run_slot(slot, value, dict(context or {}))

{
  "dataset": {
    "csv_path": "",
    "target_col": "ci",
    "date_col": "date"
  },
  "rolling": {
    "split_mode": "expanding",
    "min_train_size": 600,
    "test_size": 120,
    "step_size": 240,
    "train_window_size": 720
  },
  "base_args": {
    "regime_mode": "strict4",
    "min_leaf": 64,
    "blend_kappa": 512.0,
    "disable_merge_rare_holiday_regimes": true,
    "disable_confidence_blend": false,
    "local_search_force_linear_base": "auto",
    "local_search_topk_features": 8,
    "local_search_max_added_terms": 10,
    "local_search_max_pair_terms": 12,
    "local_search_max_candidates_per_iter": 420,
    "local_search_candidate_keep_top": 10,
    "local_search_ridge_l2": 0.0001,
    "local_search_unary_ops": "square,sin,cos,tanh",
    "local_search_nested_unary_patterns": "sin(square),cos(square)",
    "local_search_overfit_guard_enabled": true,
    "local_search_overfit_guard_val_ratio": 0.2,
    "local_search_overfit_guard_min_val_samples": 64,
    "local_search_overfit_guard_min_val_rmse_gain": 0.0,
    "local_search_overfit_guard_max_gap_increase": 0.03,
    "local_search_overfit_guard_patience": 2,
    "local_search_interaction_budget_mode": "interaction_first",
    "local_search_interaction_diag_threshold": 1.12,
    "local_search_interaction_diag_topk_features": 8,
    "local_search_interaction_pair_budget_boost": 2.0,
    "local_search_interaction_grad_projection_budget_boost": 1.8,
    "small_sample_guard_threshold": 80,
    "blend_global_backbone_mode": "symbolic_only",
    "blend_global_backbone_val_ratio": 0.2,
    "blend_global_backbone_min_val_samples": 64,
    "blend_global_backbone_margin": 0.0,
    "local_search_inner_opt_enabled": false,
    "local_search_inner_opt_method": "adam",
    "local_search_inner_opt_device": "auto",
    "local_search_inner_opt_adam_steps": 24,
    "local_search_inner_opt_adam_lr": 0.003,
    "local_search_inner_opt_lbfgs_steps": 0,
    "local_search_inner_opt_lbfgs_lr": 0.8,
    "local_search_inner_opt_l2": 0.0,
    "local_search_inner_opt_accept_rmse_tol": 1e-06
  },
  "strict4_branch_hparams_json": "examples/configs/strict4_branch_hparams_parallel_gpu_rr.json",
  "compare_runs": [
    {
      "name": "strict4_uniform_serial",
      "use_branch_hparams": false,
      "strict4_parallel_mode": "serial",
      "strict4_max_workers": 1,
      "strict4_gpu_strategy": "none",
      "strict4_gpu_devices": "",
      "overrides": {
        "local_search_inner_opt_enabled": false
      }
    },
    {
      "name": "strict4_branch_parallel_gpu_rr",
      "use_branch_hparams": true,
      "strict4_parallel_mode": "thread",
      "strict4_max_workers": 4,
      "strict4_gpu_strategy": "round_robin",
      "strict4_gpu_devices": "0,1",
      "overrides": {
        "local_search_inner_opt_enabled": true,
        "local_search_inner_opt_method": "adam",
        "local_search_inner_opt_adam_steps": 24,
        "local_search_inner_opt_lbfgs_steps": 0
      }
    }
  ]
}
